# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ====================================================================
# CONFIGURAÇÃO DO SUPABASE (Etapa 2 - Conexão Segura)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ====================================================================

# 1. FRONTEND / NAVEGADOR (Público - Usa chave anônima com RLS ativo)
# Inicia obrigatoriamente com VITE_ para injeção pelo Vite no bundle do cliente
VITE_SUPABASE_URL="https://seu-projeto-exemplo.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo-anon-key-publica"

# 2. BACKEND / SERVIDOR EXPRESS (Privado - Exclusivo do servidor)
# SUPABASE_SERVICE_ROLE_KEY possui privilégios totais e NUNCA deve ser enviada ao navegador
SUPABASE_URL="https://seu-projeto-exemplo.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo-anon-key-publica"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo-service-role-privada"

# EMAIL ADMINISTRADOR MASTER (Acesso ao painel administrativo)
ADMIN_EMAIL="chavepixedvandyemis@gmail.com"
